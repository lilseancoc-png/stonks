{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mingstreet:research-interpretation:2",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "mingstreet.research-interpretation.v2"
    },
    "export_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "experiment_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "graph_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "evaluation_plan_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "dataset_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "author_type": {
      "const": "external_ai_assisted"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 6000
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "findings": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": {
            "const": "quantitative_reference"
          },
          "claim": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "metric_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "expected_value": {
            "oneOf": [
              {
                "type": "number"
              },
              {
                "type": "string",
                "maxLength": 40,
                "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d{1,3})?$"
              }
            ]
          },
          "expected_unit": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50
          },
          "assessment": {
            "enum": [
              "supported",
              "limited",
              "unknown"
            ]
          },
          "limitations": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "required": [
          "type",
          "claim",
          "metric_id",
          "expected_value",
          "expected_unit",
          "assessment",
          "limitations"
        ]
      }
    },
    "interpretations": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 3000
      }
    },
    "unknowns": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 3000
      }
    },
    "proposed_tests": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 3000
          }
        },
        "required": [
          "title",
          "rationale"
        ]
      }
    }
  },
  "required": [
    "schema",
    "export_id",
    "experiment_id",
    "run_id",
    "graph_sha256",
    "evaluation_plan_sha256",
    "author_type",
    "summary",
    "created_at",
    "findings",
    "interpretations",
    "unknowns",
    "proposed_tests"
  ]
}
