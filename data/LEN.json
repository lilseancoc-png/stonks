 development, and sale of residential land; and development, construction, and management of multifamily rental properties. It also offers residential mortgage financing, title insurance, and closing services for home buyers and others, as well as originating and selling securitization commercial mortgage loans. In addition, the company is involved in fund investment activities. It primarily serves first-time, move-up, active adult, and luxury homebuyers. The company was founded in 1954 and is based in Miami, Florida.","industry":"Residential Construction","sector":"Consumer Cyclical","marketCap":22388516864,"trailingPE":13.079137,"forwardPE":11.976411,"pegRatio":0.75,"priceToBook":1.0232683,"priceToSales":0.6748638,"profitMargin":5.390000000000001,"operatingMargin":3.644,"grossMargin":16.871001,"returnOnEquity":8.076,"returnOnAssets":4.301,"revenueGrowthYoy":-13.3,"earningsGrowthYoy":-52.6,"earningsQuarterlyGrowthYoy":-55.800000000000004,"debtToEquity":24.992,"currentRatio":8.328,"quickRatio":3.535,"freeCashFlow":3444002816,"operatingCashFlow":72352000,"totalCash":8975199232,"totalDebt":5506315776,"revenue":33174865920,"dividendYield":2.22,"payoutRatio":28.78,"beta":1.422,"fiftyTwoWeekHigh":144.24,"fiftyTwoWeekLow":81.18,"targetMeanPrice":91.5,"targetHighPrice":124,"targetLowPrice":74,"recommendationKey":"hold","numberOfAnalystOpinions":14,"lastQuarter":{"date":"2026-02-28","period":"-1q","epsActual":0.88,"epsEstimate":0.94858,"surprisePct":-7.23},"earningsHistory":[{"date":"2025-05-31","period":"-4q","epsActual":1.9,"epsEstimate":1.93805,"surprisePct":-1.96},{"date":"2025-08-31","period":"-3q","epsActual":2,"epsEstimate":2.09472,"surprisePct":-4.52},{"date":"2025-11-30","period":"-2q","epsActual":2.03,"epsEstimate":2.17908,"surprisePct":-6.84},{"date":"2026-02-28","period":"-1q","epsActual":0.88,"epsEstimate":0.94858,"surprisePct":-7.23}],"revenueHistory":[{"date":"2025-02-28","value":7631545000},{"date":"2025-05-31","value":8377502000},{"date":"2025-08-31","value