ital platforms. The company was formerly known as Blue Ribbon Sports, Inc. and changed its name to NIKE, Inc. in May 1971. NIKE, Inc. was founded in 1964 and is headquartered in Beaverton, Oregon.","industry":"Footwear & Accessories","sector":"Consumer Cyclical","marketCap":64751783936,"trailingPE":28.766447,"forwardPE":23.980059,"pegRatio":1.59,"priceToBook":4.592962,"priceToSales":1.391823,"profitMargin":4.836,"operatingMargin":6.941999999999999,"grossMargin":40.919998,"returnOnEquity":16.016,"returnOnAssets":5.195,"revenueGrowthYoy":0.1,"earningsGrowthYoy":-34.8,"earningsQuarterlyGrowthYoy":-34.5,"debtToEquity":79.333,"currentRatio":2.139,"quickRatio":1.239,"freeCashFlow":1313874944,"operatingCashFlow":1694000000,"totalCash":8056999936,"totalDebt":11178000384,"revenue":46522998784,"dividendYield":3.5700000000000003,"payoutRatio":106.58000999999999,"beta":1.124,"fiftyTwoWeekHigh":80.17,"fiftyTwoWeekLow":41.35,"targetMeanPrice":60.77576,"targetHighPrice":120,"targetLowPrice":23,"recommendationKey":"buy","numberOfAnalystOpinions":33,"lastQuarter":{"date":"2026-02-28","period":"-1q","epsActual":0.35,"epsEstimate":0.28165,"surprisePct":24.270001},"earningsHistory":[{"date":"2025-05-31","period":"-4q","epsActual":0.14,"epsEstimate":0.12337,"surprisePct":13.48},{"date":"2025-08-31","period":"-3q","epsActual":0.49,"epsEstimate":0.2656,"surprisePct":84.489995},{"date":"2025-11-30","period":"-2q","epsActual":0.53,"epsEstimate":0.37351,"surprisePct":41.900003000000005},{"date":"2026-02-28","period":"-1q","epsActual":0.35,"epsEstimate":0.28165,"surprisePct":24.270001}],"revenueHistory":[{"date":"2025-02-28","value":11269000000},{"date":"2025-05-31","value":11097000000},{"date":"2025-08-31","value":11720000000},{"date":"2025-11-30","value":12427000000},{"date":"2026-02-28","value":11279000000}],"grossProfitHistory":[{"date":"2025-02-28","value":4675000000},{"date":"2025-05-31","value":4469000000},{"date":"2025-08-31","value":4943000000},{"date":"2025-11-30","value":5045000000