avg20":3762695,"rvol":0.53,"priceMove1dPct":-2.8,"conviction":"weak"},"chartPattern":{"pattern":"None","type":null,"direction":null,"confidence":null,"explanation":"The price action shows significant volatility and multiple peaks and troughs, but no clear formation of a classic chart pattern like a cup and handle, head and shoulders, or double bottom is evident. The recent price action does not exhibit the specific characteristics required for these patterns.","signal":"","builtAt":"2026-06-02T14:02:14.517Z"}},"fundamentals":{"name":"The Estée Lauder Companies Inc.","longBusinessSummary":"The Estée Lauder Companies Inc. manufactures, markets, and sells skin care, makeup, fragrance, and hair care products worldwide. The company offers skin care products, including moisturizers, serums, cleansers, toners, eye care, body care, exfoliators, acne care and oil correctors, facial masks, and sun care products; and makeup products, such as foundations, powders, concealers and setting sprays, lipsticks, lip liners and lip glosses, mascaras, and eyeshadows and eyeliners, as well as compacts, brushes, and other makeup tools. It also provides fragrance products in various forms comprising parfum, eau de parfum, eau de toilette, eau de cologne, and body spray, as well as lotions, creams, powders, candles and soaps; and hair care products, including shampoos, conditioners, styling products, treatment, finishing sprays, and hair colour products, as well as sells ancillary products and services. The company offers its products under the La Mer, Jo Malone London, TOM FORD, AERIN Beauty, Le Labo, Editions de Parfums Frédéric Malle, KILIAN PARIS, BALMAIN Beauty, Estée Lauder, Clinique, M·A·C, The Ordinary, Aveda, Bobbi Brown Cosmetics, Too Faced, Dr.Jart+, Bumble and bumble, Editions de Parfums Frédéric Malle, Smashbox, Darphin Paris, Lab Series, NIOD, Aramis, and GLAMGLOW brands. It sells its products through department stores, duty-free retailers, specialty multi retailers, online pure players, upscale perfumeries and pharmacies, and top-tier salons and spas, as well as direct-to-consumer businesses across freestanding stores, and brand websites and third-party online platforms. The Estée Lauder Companies Inc. was founded in 1946 and is headquartered in New York, New York.","industry":"Household & Personal Products","sector":"Consumer Defensive","marketCap":30094100480,"trailingPE":null,"forwardPE":26.167353,"pegRatio":1.42,"priceToBook":7.5364685,"priceToSales":2.0288613,"profitMargin":-1.672,"operatingMargin":14.924999999999999,"grossMargin":74.651,"returnOnEquity":-5.949,"returnOnAssets":4.874,"revenueGrowthYoy":4.6,"earningsGrowthYoy":-45.5,"earningsQuarterlyGrowthYoy":-44,"debtToEquity":232.908,"currentRatio":1.268,"quickRatio":0.824,"freeCashFlow":1807624960,"operatingCashFlow":1798000000,"totalCash":3126000128,"totalDebt":9299999744,"revenue":14833000448,"dividendYield":1.6400000000000001,"payoutRatio":471.42999999999995,"beta":1.211,"fiftyTwoWeekHigh":121.64,"fiftyTwoWeekLow":64.83,"targetMeanPrice":95.43478,"targetHighPrice":125,"targetLowPrice":70,"recommendationKey":"buy","numberOfAnalystOpinions":23,"lastQuarter":{"date":"2026-03-31","period":"-1q","epsActual":0.91,"epsEstimate":0.64907,"surprisePct":40.2},"earningsHistory":[{"date":"2025-06-30","period":"-4q","epsActual":0.09,"epsEstimate":0.08905,"surprisePct":1.0699999999999998},{"date":"2025-09-30","period":"-3q","epsActual":0.32,"epsEstimate":0.17594,"surprisePct":81.88},{"date":"2025-12-31","period":"-2q","epsActual":0.89,"epsEstimate":0.83491,"surprisePct":6.6000000000000005},{"date":"2026-03-31","period":"-1q","epsActual":0.91,"epsEstimate":0.64907,"surprisePct":40.2}],"revenueHistory":[{"date":"2025-03-31","value":3550000000},{"date":"2025-06-30","value":3411000000},{"date":"2025-09-30","value":3481000000},{"date":"2025-12-31","value":4229000000},{"date":"2026-03-31","value":3712000000}],"grossProfitHistory":[{"date":"2025-03-31","value":2661000000},{"date":"2025-06-30","va