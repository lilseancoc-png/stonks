e tools and educational content. The Company operates through branch offices. The Charles Schwab Corporation was founded in 1971 and is headquartered in Westlake, Texas.","industry":"Capital Markets","sector":"Financial Services","marketCap":152365662208,"trailingPE":17.417494,"forwardPE":12.136148,"pegRatio":1.07,"priceToBook":3.5854309,"priceToSales":6.142786,"profitMargin":37.986,"operatingMargin":49.352002,"grossMargin":97.46000000000001,"returnOnEquity":19.083,"returnOnAssets":1.9709998999999998,"revenueGrowthYoy":15.8,"earningsGrowthYoy":38.6,"earningsQuarterlyGrowthYoy":29.9,"debtToEquity":120.766,"currentRatio":0.632,"quickRatio":0.632,"freeCashFlow":null,"operatingCashFlow":10293999616,"totalCash":96474996736,"totalDebt":59457998848,"revenue":24803999744,"dividendYield":1.4400001,"payoutRatio":22.469998999999998,"beta":0.797,"fiftyTwoWeekHigh":107.5,"fiftyTwoWeekLow":83.96,"targetMeanPrice":115.85,"targetHighPrice":137,"targetLowPrice":84,"recommendationKey":"buy","numberOfAnalystOpinions":20,"lastQuarter":{"date":"2026-03-31","period":"-1q","epsActual":1.43,"epsEstimate":1.39538,"surprisePct":2.48},"earningsHistory":[{"date":"2025-06-30","period":"-4q","epsActual":1.14,"epsEstimate":1.09818,"surprisePct":3.81},{"date":"2025-09-30","period":"-3q","epsActual":1.31,"epsEstimate":1.24507,"surprisePct":5.21},{"date":"2025-12-31","period":"-2q","epsActual":1.39,"epsEstimate":1.39377,"surprisePct":-0.27},{"date":"2026-03-31","period":"-1q","epsActual":1.43,"epsEstimate":1.39538,"surprisePct":2.48}],"revenueHistory":[{"date":"2025-03-31","value":5599000000},{"date":"2025-06-30","value":5851000000},{"date":"2025-09-30","value":6135000000},{"date":"2025-12-31","value":6336000000},{"date":"2026-03-31","value":6482000000}],"grossProfitHistory":[],"netIncomeHistory":[{"date":"2025-03-31","value":1909000000},{"date":"2025-06-30","value":2126000000},{"date":"2025-09-30","value":2358000000},{"date":"2025-12-31","value":2459000000},{"date":"2026-03-31","value":2479000000}]