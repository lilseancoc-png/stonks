node_modules/
.DS_Store
*.log

# Local credential files for the private store (R2 / Blob) — never commit.
# Used as `node --env-file=r2.env scripts/{sync-data,wipe-history}.mjs`.
r2.env
*.env
.env

# Path B private-data migration: the premium data/*.json now live in a private
# Vercel Blob store (lib/datastore.mjs), hydrated/flushed by scripts/sync-data.mjs
# and served through the gated /api/data/* — they are NO LONGER committed to this
# (public) repo. The build/scan workflows write data/ locally and push it to the
# store; the gate reads from the store. Restoring the old commit-data model means
# removing this ignore + reverting the workflow flip + unsetting PRIVATE_DATA_ENABLED.
# Leading slash anchors to the repo root ONLY — an unanchored `data/` also matches
# api/data/ (the gated reader) and any other nested data dir.
/data/

# Per-run AI-layer health report (writeAiHealthReport in scripts/build.mjs).
# Consumed by daily.yml's "AI health alert" step (auto-issue + optional Discord
# ping); never committed — each run regenerates it.
/ai-health.json
